# Copy outside version control and replace every placeholder using a secret manager.
POSTGRES_DB=skillbridge
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=replace-with-a-unique-long-random-secret
DATABASE_URL=postgresql://skillbridge:replace-with-a-unique-long-random-secret@postgres:5432/skillbridge

REDIS_PASSWORD=replace-with-another-unique-long-random-secret
REDIS_URL=redis://:replace-with-another-unique-long-random-secret@redis:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=https://replace-with-your-hostname
PUBLIC_APP_URL=https://replace-with-your-hostname
TRUST_PROXY=2
AUTH_COOKIE_SAME_SITE=lax

RESUME_S3_BUCKET=replace-with-private-bucket-name
RESUME_S3_REGION=replace-with-bucket-region
RESUME_S3_ENDPOINT=
RESUME_S3_FORCE_PATH_STYLE=false
RESUME_S3_KMS_KEY_ID=

SMTP_URL=smtps://replace-with-smtp-credentials
EMAIL_FROM=replace-with-verified-sender

# Expose the web container only to a local TLS-terminating ingress by default.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
